# Copy to .env (gitignored) and fill in. Consumed by monograph, graph/*.sh, and
# passed into Dagger as secrets by the CI functions.
#
# Leave this file entirely out to fall back to the local Docker container
# (neo4j://localhost:7687, user neo4j, password monograph2026).

# Aura: neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
